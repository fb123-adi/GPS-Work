# ===== Kyveron E-Commerce Environment Variables =====
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ===== Application =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Kyveron
NODE_ENV=development

# ===== Supabase =====
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# WARNING: Service role key has full database access. Server-only!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Razorpay =====
# Get from https://dashboard.razorpay.com → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# WARNING: Secret key. Server-only! Never expose to frontend.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Set this in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ===== Email (Resend) =====
# Get from https://resend.com → API Keys
# WARNING: API key. Server-only!
RESEND_API_KEY=re_your_api_key
NEXT_PUBLIC_SUPPORT_EMAIL=support@kyveron.in
NEXT_PUBLIC_SUPPORT_PHONE=+919876543210

# ===== OAuth Providers (Optional) =====
# Google: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple: https://developer.apple.com → Certificates, Identifiers & Profiles
APPLE_ID=com.kyveron.app
APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# ===== Storage =====
NEXT_PUBLIC_STORAGE_CDN=https://cdn.kyveron.in

# ===== Analytics (Consent-Gated) =====
# Only loaded after user gives consent
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id

# ===== Security =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# WARNING: Server-only secrets
JWT_SECRET=generate-a-secure-random-string
ENCRYPTION_KEY=generate-a-secure-encryption-key

# ===== Feature Flags =====
ENABLE_COD=false
ENABLE_INTERNATIONAL=false
ENABLE_EMI=false
ENABLE_MAGIC_LINK=true
ENABLE_BACK_IN_STOCK_NOTIFICATIONS=true

# ===== Business =====
BUSINESS_NAME=Kyveron
BUSINESS_ADDRESS=Your Business Address, City, State, PIN
BUSINESS_GSTIN=Your GST Number
BUSINESS_CIN=Your CIN Number
GRIEVANCE_OFFICER_NAME=Officer Name
GRIEVANCE_OFFICER_EMAIL=grievance@kyveron.in
GRIEVANCE_OFFICER_PHONE=+919876543210

# ===== Privacy & email endpoints (storefront, optional) =====
# Until these are set, the data-request and unsubscribe pages open a pre-filled email to the
# privacy address in src/lib/business.ts, and newsletter sign-up says it isn't live yet.
VITE_PRIVACY_REQUEST_ENDPOINT=
VITE_UNSUBSCRIBE_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=
