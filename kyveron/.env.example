# ---------------------------------------------------------------------------
# Kyveron environment. Copy to .env.local (development) or set in your host.
# NEVER commit real values. Variables prefixed NEXT_PUBLIC_ are sent to the
# browser; everything else stays on the server.
# ---------------------------------------------------------------------------

# development | test | staging | production. Mock drivers refuse to run in production.
APP_ENV=development
APP_URL=http://localhost:3000

# Postgres. On Supabase: Project Settings > Database > Connection string (use the
# pooled "Transaction" URL on port 6543 for serverless hosts).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kyveron
DATABASE_POOL_MAX=10

# 32+ random characters. Signs sessions, order-access and admin-activity cookies.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# --- Auth (Supabase) -------------------------------------------------------
# Leave blank in development to use the local email/password driver (dev only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for Storage uploads. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
# supabase | local (auto-detected when blank)
AUTH_DRIVER=
ADMIN_REQUIRE_MFA=true
ADMIN_IDLE_TIMEOUT_MINUTES=30

# --- Payments (Razorpay) ---------------------------------------------------
# Dashboard > Account & Settings > API Keys. Use test keys until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks. Endpoint: {APP_URL}/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Optional: secret for the local mock gateway (derived from SESSION_SECRET if blank).
MOCK_PAYMENT_SECRET=

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Kyveron <orders@yourdomain.in>"
SUPPORT_EMAIL=support@yourdomain.in

# --- Bot protection (Cloudflare Turnstile) ----------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Operations ------------------------------------------------------------
# Bearer token your scheduler sends to /api/cron/* endpoints.
CRON_SECRET=
# Local upload directory (development storage driver only).
UPLOAD_DIR=.data/uploads
# Keep false until international shipping, duties, tax and refunds are configured.
INTERNATIONAL_CHECKOUT_ENABLED=false
# Keep false unless your courier supports COD reconciliation.
COD_ENABLED=false
